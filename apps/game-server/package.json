{
  "name": "@pillage-first/game-server",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "game-server": "vite-node --watch src/server.ts",
    "start": "vite-node src/server.ts",
    "type-check": "tsc --noEmit",
    "lint:check": "biome lint --no-errors-on-unmatched",
    "lint": "biome lint --fix --no-errors-on-unmatched",
    "lint:check/oxlint": "oxlint .",
    "lint/oxlint": "oxlint --fix .",
    "format:check": "biome ci --linter-enabled=false",
    "format": "biome check --write --no-errors-on-unmatched",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@pillage-first/api": "*",
    "@pillage-first/game-assets": "*",
    "@pillage-first/mocks": "*",
    "@pillage-first/types": "*",
    "@pillage-first/utils": "*",
    "hono": "4.13.14",
    "mysql2": "3.15.3",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-node": "3.2.4",
    "vitest": "5.0.5"
  }
}
