# HTTP + WebSocket listen port
PORT=3010

# Comma-separated CORS origins for the web app (Vite default port 5173).
# Required when connecting from apps/web "Remote server" flow.
# Empty = allow all origins in this scaffold.
CORS_ORIGINS=http://localhost:5173

# MySQL — REQUIRED for online game-server (meta `online_*` + game kernel tables).
# There is no SQLite/WASM fallback: if MySQL is unreachable, the process exits.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=pillage
MYSQL_PASSWORD=pillage
MYSQL_DATABASE=pillage_online

# Defaults to true. Online always needs MySQL; game-server refuses to start without it.
MYSQL_REQUIRED=true

# Stub auth: map Authorization Bearer tokens → playerId (JSON object).
# Example: {"dev-token":1}
AUTH_TOKEN_PLAYER_MAP={"dev-token":1}

# Admin tokens allowed to hit /combat-simulator online (JSON array of tokens).
AUTH_ADMIN_TOKENS=["admin-token"]
